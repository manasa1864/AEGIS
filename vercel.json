{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/gemini/:path*", "destination": "https://generativelanguage.googleapis.com/:path*" },
    { "source": "/api/groq/:path*", "destination": "https://api.groq.com/:path*" },
    { "source": "/api/anthropic/:path*", "destination": "https://api.anthropic.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
