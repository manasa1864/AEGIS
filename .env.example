# ── Frontend keys (used by Vite — prefix VITE_ required) ──────────────────────
VITE_GITHUB_PAT=your_github_personal_access_token_here
VITE_GITLAB_PAT=your_gitlab_personal_access_token_here

# Gemini AI Studio key (used by the healing agent in src/app/lib/agent/loop.ts)
VITE_GEMINI_KEY=your_gemini_ai_studio_key_here

# Google Cloud Agent Builder key (separate key from GCP console)
VITE_GCLOUD_KEY=your_google_cloud_agent_builder_key_here

VITE_GROQ_KEY=your_groq_api_key_here

# URL of the Flask backend (localhost in dev, Render URL in production)
VITE_BACKEND_URL=http://localhost:5000

# ── GitLab MCP bridge (used by server.js) ─────────────────────────────────────
GITLAB_URL=https://gitlab.com

# ── Flask backend (put these in backend/.env, NOT here) ───────────────────────
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/aegis
# SECRET_KEY=generate-with-python-secrets-token-hex
