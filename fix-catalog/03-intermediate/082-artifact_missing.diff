# Aegis fix catalog #082 — Download job runs before the upload job
#
# Tier:       3 · Intermediate
# Category:   artifact_missing (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | Error: Unable to download artifact(s): Artifact not found for name: build-output
#   | No artifact found with name build-output
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Made artifact downloads wait for their uploads: deploy now needs [build] — without needs: the jobs start in parallel and download-artifact fails with "Artifact not found" before the upload exists
#
# Apply:      git apply 03-intermediate/082-artifact_missing.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -18,6 +18,7 @@
           name: build-output
           path: dist/
   deploy:
+    needs: [build]
     runs-on: ubuntu-latest
     timeout-minutes: 15
     steps:
