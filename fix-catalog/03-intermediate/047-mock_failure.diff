# Aegis fix catalog #047 — Mocks leaking between tests
#
# Tier:       3 · Intermediate
# Category:   mock_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | expect(jest.fn()).toHaveBeenCalledTimes(expected)
#   | Expected number of calls: 1
#   | Received number of calls: 3
#   | mock not called as expected — spy not invoked with fresh state
#
# How it is solved:
#   MODIFY jest.config.js
#     - Added clearMocks/resetMocks/restoreMocks to jest.config — prevents mock state leaking between suites
#
# Apply:      git apply 03-intermediate/047-mock_failure.diff
diff --git a/jest.config.js b/jest.config.js
--- a/jest.config.js
+++ b/jest.config.js
@@ -1,3 +1,6 @@
 module.exports = {
+  clearMocks: true,
+  resetMocks: true,
+  restoreMocks: true,
   testEnvironment: 'node',
 };
