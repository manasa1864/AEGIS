# Aegis fix catalog #083 — Unhandled promise rejection passes CI silently
#
# Tier:       3 · Intermediate
# Category:   unhandled_exception (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | (node:2231) UnhandledPromiseRejectionWarning: Error: connect ECONNREFUSED 127.0.0.1:6379
#   | (node:2231) UnhandledPromiseRejectionWarning: Unhandled promise rejection.
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added --unhandled-rejections=throw — unhandled promise rejections were silently passing CI
#
# Apply:      git apply 03-intermediate/083-unhandled_exception.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,6 +14,7 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  NODE_OPTIONS: --unhandled-rejections=throw
 jobs:
   build:
     runs-on: ubuntu-latest
