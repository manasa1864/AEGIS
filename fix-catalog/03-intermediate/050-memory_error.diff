# Aegis fix catalog #050 — Node heap out of memory during build
#
# Tier:       3 · Intermediate
# Category:   memory_error (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | <--- Last few GCs --->
#   | FATAL ERROR: Reached heap limit Allocation failed - JavaScript heap out of memory
#   |  1: 0xb7a940 node::Abort() [node]
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added NODE_OPTIONS=--max-old-space-size=4096 + 4GB swap space — Node.js ran out of heap during build
#     - defaulting to 4096MB
#     - Added MALLOC_ARENA_MAX=2 + MALLOC_MMAP_THRESHOLD — reduces glibc memory arena fragmentation on large Linux builds
#     - Upgraded to ubuntu-latest-4-cores runner — the job was OOM-killed on a 2-core runner
#     - 4-core GitHub-hosted runners have 16 GB RAM (vs 7 GB for standard) and are available for most GitHub plan tiers
#
# Apply:      git apply 03-intermediate/050-memory_error.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,9 +14,12 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  NODE_OPTIONS: --max-old-space-size=4096 --expose-gc
+  MALLOC_ARENA_MAX: 2
+  MALLOC_MMAP_THRESHOLD_: 131072
 jobs:
   build:
-    runs-on: ubuntu-latest
+    runs-on: ubuntu-latest-4-cores
     timeout-minutes: 15
     steps:
       - uses: actions/checkout@v4
@@ -25,5 +28,13 @@
           node-version: 20
           cache: npm
       - run: npm ci
+      - name: Create swap space for large builds
+        run: |
+          sudo fallocate -l 4G /swapfile
+          sudo chmod 600 /swapfile
+          sudo mkswap /swapfile
+          sudo swapon /swapfile
+          echo "Swap space enabled:"
+          free -h
       - run: npm run build
       - run: npm test
