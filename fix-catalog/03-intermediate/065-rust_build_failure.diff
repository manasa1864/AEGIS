# Aegis fix catalog #065 — Cargo build without toolchain / cache
#
# Tier:       3 · Intermediate
# Category:   rust_build_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | error[E0433]: failed to resolve: use of undeclared crate or module `tokio`
#   |  --> src/main.rs:3:5
#   | error: could not compile `app` (bin "app") due to 1 previous error
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added RUST_BACKTRACE=1 and CARGO_TERM_COLOR to CI — RUST_BACKTRACE provides full stack traces on panic
#     - CARGO_TERM_COLOR ensures colored output in CI logs
#
# Apply:      git apply 03-intermediate/065-rust_build_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,6 +14,8 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  RUST_BACKTRACE: "1"
+  CARGO_TERM_COLOR: always
 jobs:
   build:
     runs-on: ubuntu-latest
