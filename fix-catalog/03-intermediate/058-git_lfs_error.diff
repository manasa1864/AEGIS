# Aegis fix catalog #058 — Git LFS objects not fetched
#
# Tier:       3 · Intermediate
# Category:   git_lfs_error (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | Error downloading object: assets/model.bin (a1b2c3): Smudge error
#   | smudge filter lfs failed
#   | Error: git-lfs pointer file found instead of content
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added lfs: true to actions/checkout — Git LFS files failed to download
#     - with lfs: true the checkout step fetches the real file content instead of LFS pointer files
#
# Apply:      git apply 03-intermediate/058-git_lfs_error.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -20,6 +20,8 @@
     timeout-minutes: 15
     steps:
       - uses: actions/checkout@v4
+        with:
+          lfs: true
       - uses: actions/setup-node@v4
         with:
           node-version: 20
