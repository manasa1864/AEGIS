# Aegis fix catalog #052 — .NET build without SDK setup / restore
#
# Tier:       3 · Intermediate
# Category:   dotnet_build_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | error NU1101: Unable to find package Newtonsoft.Json. No packages exist with this id in source(s): nuget.org
#   | Build FAILED.
#   | dotnet build FAILED — MSBuild Error
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added .NET CI env vars — DOTNET_SKIP_FIRST_TIME_EXPERIENCE and DOTNET_NOLOGO eliminate welcome banners that clutter logs
#     - DOTNET_CLI_TELEMETRY_OPTOUT prevents telemetry traffic
#     - NUGET_PACKAGES path enables cache hits
#     - Added dotnet restore --locked-mode — .NET must restore NuGet packages before building
#     - --locked-mode enforces packages.lock.json for reproducible restores
#
# Apply:      git apply 03-intermediate/052-dotnet_build_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,11 +14,17 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  DOTNET_SKIP_FIRST_TIME_EXPERIENCE: '1'
+  DOTNET_CLI_TELEMETRY_OPTOUT: '1'
+  NUGET_PACKAGES: ${{ github.workspace }}/.nuget/packages
+  DOTNET_NOLOGO: 'true'
 jobs:
   build:
     runs-on: ubuntu-latest
     timeout-minutes: 15
     steps:
       - uses: actions/checkout@v4
+      - name: Restore .NET packages
+        run: dotnet restore --locked-mode
       - run: dotnet build --configuration Release
       - run: dotnet test
