# Aegis fix catalog #057 — Maven dependency resolution without JDK/cache
#
# Tier:       3 · Intermediate
# Category:   maven_build_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | [ERROR] Failed to execute goal on project app: Could not resolve dependencies for project com.acme:app:jar:1.0: maven
#   | [INFO] BUILD FAILURE — maven
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added actions/setup-java@v4 (Temurin 21 LTS) — Maven/Gradle detected but no Java setup step
#     - Temurin is the recommended free OpenJDK distribution with built-in maven dependency caching
#     - Added JVM options — CI runners have limited memory
#     - MAVEN_OPTS/GRADLE_OPTS set heap size and file encoding
#     - Gradle daemon disabled to avoid persistent background processes
#
# Apply:      git apply 03-intermediate/057-maven_build_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,10 +14,17 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  MAVEN_OPTS: '-Xmx1024m -Dfile.encoding=UTF-8'
 jobs:
   build:
     runs-on: ubuntu-latest
     timeout-minutes: 15
     steps:
       - uses: actions/checkout@v4
+      - name: Set up JDK 21
+        uses: actions/setup-java@v4
+        with:
+          java-version: '21'
+          distribution: 'temurin'
+          cache: 'maven'
       - run: mvn -B package
