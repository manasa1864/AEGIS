# Aegis fix catalog #063 — HTTPS git auth has no credentials
#
# Tier:       3 · Intermediate
# Category:   git_credential_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | fatal: could not read Username for 'https://github.com': terminal prompts disabled
#   | Error: git fetch failed — Authentication failed for git
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added git credential store — git prompts for username/password in CI when HTTPS remotes are unauthenticated
#     - terminal prompts are disabled in CI so git hangs or fails
#     - credential store injects the token for all HTTPS operations
#
# Apply:      git apply 03-intermediate/063-git_credential_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -25,4 +25,9 @@
           node-version: 20
           cache: npm
       - run: npm ci
+      - name: Configure git credentials
+        run: |
+          git config --global credential.helper store
+          echo "https://x-access-token:${{ secrets.GITHUB_TOKEN }}@github.com" > ~/.git-credentials
+          git config --global url."https://github.com/".insteadOf "git@github.com:"
       - run: git clone https://github.com/acme/private-lib.git lib
