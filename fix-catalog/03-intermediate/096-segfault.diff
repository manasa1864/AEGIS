# Aegis fix catalog #096 — Native crash with no core dump or backtrace
#
# Tier:       3 · Intermediate
# Category:   segfault (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | Segmentation fault (core dumped)
#   | npm ERR! signal SIGSEGV
#   | npm ERR! command sh -c node scripts/render.js
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added core dump upload artifact step — SIGSEGV segfault
#     - core files now preserved as CI artifacts for post-mortem gdb backtrace analysis
#
# Apply:      git apply 03-intermediate/096-segfault.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -27,3 +27,14 @@
           node-version: 20
       - run: npm ci
       - run: node scripts/render.js
+
+      - name: Upload core dumps
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: core-dumps
+          path: |
+            /tmp/core.*
+            core
+          if-no-files-found: ignore
+          retention-days: 3
\ No newline at end of file
