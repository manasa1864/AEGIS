# Aegis fix catalog #073 — One matrix leg cancels all others
#
# Tier:       3 · Intermediate
# Category:   matrix_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | The strategy configuration was canceled because "build.node_18" failed
#   | matrix job cancelled — fail-fast cancelled remaining jobs
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added fail-fast: false to matrix strategy — by default GitHub cancels all matrix jobs when one fails
#     - fail-fast: false lets all matrix combinations complete so you see ALL failures across Node versions/OSes, not just the first one
#     - Added ci-success fan-in job — branch protection rules require a specific job to pass
#     - a matrix job's individual entries cannot be referenced by name in branch protection
#     - a fan-in summary job provides a stable single job name that aggregates all matrix results
#
# Apply:      git apply 03-intermediate/073-matrix_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -19,6 +19,7 @@
     runs-on: ubuntu-latest
     timeout-minutes: 15
     strategy:
+      fail-fast: false
       matrix:
         node: [18, 20, 22]
     steps:
@@ -27,3 +28,18 @@
         with:
           node-version: ${{ matrix.node }}
       - run: npm ci && npm test
+
+  ci-success:
+    name: CI passed
+    if: always()
+    needs: [pull_request, build]
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check all matrix results
+        run: |
+          results="${{ needs.pull_request.result }} ${{ needs.build.result }}"
+          for r in $results; do
+            if [ "$r" != "success" ] && [ "$r" != "skipped" ]; then
+              echo "Job failed with result: $r"; exit 1
+            fi
+          done
