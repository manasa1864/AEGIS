# Aegis fix catalog #051 — Cargo build without toolchain / cache
#
# Tier:       3 · Intermediate
# Category:   rust_build_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | error[E0433]: failed to resolve: use of undeclared crate or module `tokio`
#   |  --> src/main.rs:3:5
#   | error: could not compile `app` (bin "app") due to 1 previous error
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added Rust CI env vars — CARGO_TERM_COLOR=always preserves colored output
#     - RUST_BACKTRACE=1 shows full backtraces on panics
#     - CARGO_INCREMENTAL=0 is faster for clean CI builds
#     - Added Swatinem/rust-cache@v2 — Rust compilation without caching takes 5-15 min per build
#     - this cache covers target/ and ~/.cargo/registry reducing build time by 70-90%
#   CREATE rust-toolchain.toml
#     - Created rust-toolchain.toml pinning stable channel — without toolchain pinning, CI uses the runner's default Rust version which changes on runner image updates
#     - musl target enables static linking for portable binaries
#
# Apply:      git apply 03-intermediate/051-rust_build_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,11 +14,18 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  CARGO_TERM_COLOR: always
+  RUST_BACKTRACE: 1
+  CARGO_INCREMENTAL: '0'
 jobs:
   build:
     runs-on: ubuntu-latest
     timeout-minutes: 15
     steps:
       - uses: actions/checkout@v4
+      - name: Cache Rust dependencies
+        uses: Swatinem/rust-cache@v2
+        with:
+          cache-on-failure: true
       - run: cargo build --release
       - run: cargo test
diff --git a/rust-toolchain.toml b/rust-toolchain.toml
new file mode 100644
--- /dev/null
+++ b/rust-toolchain.toml
@@ -0,0 +1,4 @@
+[toolchain]
+channel = "stable"
+components = ["rustfmt", "clippy"]
+targets = ["x86_64-unknown-linux-musl"]
