# Aegis fix catalog #069 — Artifact upload fails on transient error
#
# Tier:       3 · Intermediate
# Category:   artifact_upload_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | Error: Failed to upload artifact: Unable to make request: ECONNRESET
#   | artifact upload failed after 5 attempts
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added retention-days: 7 to artifact uploads — artifacts default to 90 days which wastes storage quota
#     - 7 days is sufficient for most CI debugging purposes
#     - Added if-no-files-found: error — the default is "warn" which lets a missing artifact pass silently
#     - downstream download-artifact steps then fail with a confusing "artifact not found" message
#     - "error" fails immediately with a clear message at the upload step
#     - Added S3 fallback on artifact upload failure — GitHub artifact storage has occasional outages
#     - uploading to S3 as a fallback ensures build outputs are preserved even when the GitHub service is degraded
#
# Apply:      git apply 03-intermediate/069-artifact_upload_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -26,6 +26,16 @@
           cache: npm
       - run: npm ci
       - uses: actions/upload-artifact@v4
+      - name: Fallback upload to S3
+        if: failure()
+        run: |
+          aws s3 cp ./dist/ s3://${{ secrets.ARTIFACTS_BUCKET }}/${{ github.run_id }}/ --recursive
+        env:
+          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
+          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
+          AWS_DEFAULT_REGION: us-east-1
         with:
           name: reports
           path: reports/
+          if-no-files-found: error
+          retention-days: 7
