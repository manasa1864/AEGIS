# Aegis fix catalog #043 — Snapshot mismatch fails CI with no diff to inspect
#
# Tier:       3 · Intermediate
# Category:   snapshot_mismatch
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | › 1 snapshot failed from 1 test suite. Inspect your code changes or run `npm test -- -u` to update them.
#   | Snapshot Summary
#   |  › 1 snapshot failed from 1 test suite.
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added --updateSnapshot step gated on workflow_dispatch — snapshot mismatch
#     - snapshots update only on manual trigger, not on PRs
#     - Added snapshot artifact upload on failure — snapshot mismatch
#     - reviewers can download .snap files from CI to inspect exact differences
#
# Apply:      git apply 03-intermediate/043-snapshot_mismatch.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -26,3 +26,15 @@
           cache: npm
       - run: npm ci
       - run: npx jest --ci
+
+      - name: Update snapshots (workflow_dispatch only)
+        if: github.event_name == 'workflow_dispatch'
+        run: npx jest --ci --updateSnapshot
+      - name: Upload snapshot diffs
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: snapshot-diffs
+          path: "**/__snapshots__/**/*.snap"
+          if-no-files-found: ignore
+          retention-days: 7
\ No newline at end of file
