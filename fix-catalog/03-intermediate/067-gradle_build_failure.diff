# Aegis fix catalog #067 — Gradle wrapper not executable / no JDK
#
# Tier:       3 · Intermediate
# Category:   gradle_build_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | ./gradlew: Permission denied
#   | FAILURE: Build failed with an exception.
#   | * What went wrong: gradle build failed
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added chmod +x for permission-denied scripts — Git does not preserve execute bits on Windows checkouts
#     - scripts need +x before they can run
#
# Apply:      git apply 03-intermediate/067-gradle_build_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -20,4 +20,4 @@
     timeout-minutes: 15
     steps:
       - uses: actions/checkout@v4
-      - run: ./gradlew build
+      - run: chmod +x ./gradlew && ./gradlew build
