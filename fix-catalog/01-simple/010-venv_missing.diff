# Aegis fix catalog #010 — Python virtualenv not created / activated
#
# Tier:       1 · Simple
# Category:   venv_missing (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | /home/runner/work/_temp/abc.sh: line 1: .venv/bin/activate: No such file or directory
#   | Error: .venv activate failed — virtualenv not created
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added a step that creates the virtualenv before it is activated (job "build" activates .venv but never created it) — a fresh runner has no .venv directory, so "source .venv/bin/activate" fails
#
# Apply:      git apply 01-simple/010-venv_missing.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -20,4 +20,8 @@
     timeout-minutes: 15
     steps:
       - uses: actions/checkout@v4
+      - name: Create virtual environment
+        run: |
+          python3 -m venv .venv
+          .venv/bin/pip install -r requirements.txt
       - run: source .venv/bin/activate && pytest
