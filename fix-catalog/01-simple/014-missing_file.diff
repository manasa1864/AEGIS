# Aegis fix catalog #014 — docker build looks for ./Dockerfile but it lives in a subfolder
#
# Tier:       1 · Simple
# Category:   missing_file
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | ERROR: failed to solve: failed to read dockerfile: open Dockerfile: no such file or directory
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Pointed docker build at docker/Dockerfile (-f) — the build looked for ./Dockerfile, which does not exist
#     - docker/Dockerfile is the only Dockerfile in the repo
#
# Apply:      git apply 01-simple/014-missing_file.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -29,5 +29,5 @@
         with:
           username: ${{ secrets.DOCKERHUB_USERNAME }}
           password: ${{ secrets.DOCKERHUB_TOKEN }}
-      - run: docker build -t app:latest .
+      - run: docker build -f docker/Dockerfile -t app:latest .
       - run: docker push app:latest
