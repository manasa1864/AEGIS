# Aegis fix catalog #014 — Build references a Dockerfile that does not exist
#
# Tier:       1 · Simple
# Category:   missing_file
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | ERROR: failed to solve: failed to read dockerfile: open Dockerfile: no such file or directory
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added DOCKER_BUILDKIT=1 — enables BuildKit for faster layer caching and parallel build stages
#
# Apply:      git apply 01-simple/014-missing_file.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,6 +14,8 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  DOCKER_BUILDKIT: 1
+  BUILDKIT_INLINE_CACHE: 1
 jobs:
   build:
     runs-on: ubuntu-latest
