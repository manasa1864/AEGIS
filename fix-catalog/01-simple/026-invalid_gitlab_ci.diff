# Aegis fix catalog #026 — Deprecated `only:` / `except:` in .gitlab-ci.yml
#
# Tier:       1 · Simple
# Category:   invalid_gitlab_ci (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | Found errors in your .gitlab-ci.yml:
#   | jobs:deploy config contains unknown keys: only
#   | gitlab ci configuration invalid
#
# How it is solved:
#   MODIFY .gitlab-ci.yml
#     - Replaced deprecated only:/except: with rules: — GitLab CI deprecated only/except
#     - rules: supports more conditions, is the recommended syntax, and is required for merge request pipelines
#
# Apply:      git apply 01-simple/026-invalid_gitlab_ci.diff
diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -20,5 +20,7 @@
   image: node:20
   script:
     - npm run deploy
-  only:
-    - main
+  rules:
+    - if: '$CI_COMMIT_BRANCH == "main" || $CI_MERGE_REQUEST_TARGET_BRANCH_NAME == "main"'
+      when: always
+    - when: never
