# Aegis fix catalog #012 — Required secret not configured
#
# Tier:       1 · Simple
# Category:   secret_missing (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | Error: Input required and not supplied: token
#   | Environment variable NPM_TOKEN is required but not set
#   | secret NPM_TOKEN not set — required
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added required-secrets preflight check for: NPM_TOKEN — surfaces missing secrets immediately with a clear message instead of failing mid-job with an obscure error
#
# Apply:      git apply 01-simple/012-secret_missing.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -19,6 +19,11 @@
     runs-on: ubuntu-latest
     timeout-minutes: 15
     steps:
+      - name: Check required secrets
+        run: |
+          MISSING=0
+          [ -n "${{ secrets.NPM_TOKEN }}" ] || (echo "ERROR: secret 'NPM_TOKEN' is not configured" && MISSING=1)
+          [ $MISSING -eq 0 ] || (echo "Add missing secrets at Settings > Secrets and variables > Actions" && exit 1)
       - uses: actions/checkout@v4
       - uses: actions/setup-node@v4
         with:
