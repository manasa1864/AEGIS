# Aegis fix catalog #099 — AWS CLI with no credentials / region
#
# Tier:       4 · Advanced
# Category:   aws_auth_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | Unable to locate credentials. You can configure credentials by running "aws configure".
#   | NoCredentialProviders: no valid providers in chain
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added AWS_DEFAULT_REGION=us-east-1 — AWS CLI and SDK require a region
#     - without it commands fail with 'You must specify a region'
#     - update to your target region
#
# Apply:      git apply 04-advanced/099-aws_auth_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,6 +14,7 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  AWS_DEFAULT_REGION: us-east-1
 jobs:
   build:
     runs-on: ubuntu-latest
