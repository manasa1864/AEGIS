# Aegis fix catalog #087 — Invalid Dockerfile instructions
#
# Tier:       4 · Advanced
# Category:   dockerfile_syntax (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | ERROR: failed to solve: dockerfile parse error on line 5: unknown instruction: CMD["node",
#
# How it is solved:
#   CREATE .dockerignore
#     - Created .dockerignore — without it, docker build sends node_modules, .git, and test files to the build context
#     - this increases build time, image size, and can leak secrets from .env files into the image
#     - Added secret file patterns to .dockerignore (*.pem, *.key, *.p12, *.pfx, ...) — if these files exist in the build context, COPY . . would include them in the image layer, permanently exposing secrets in docker history
#   MODIFY Dockerfile
#     - Replaced ADD with COPY for local files — ADD has implicit behaviors (URL download, tar auto-extraction) that make builds non-deterministic
#     - COPY is always explicit and predictable
#     - Fixed relative WORKDIR "WORKDIR app" to /app — WORKDIR with a relative path resolves from the previous WORKDIR which can be unpredictable
#     - always use absolute paths
#     - Added non-root USER before CMD — containers running as root violate the principle of least privilege and fail many security scanners (Trivy, Snyk, AWS ECR scan)
#     - UID 1001 is a common non-privileged choice
#     - Added --omit=dev to npm ci — devDependencies (test frameworks, build tools) have no place in production images
#     - --omit=dev reduces node_modules by 30-70%
#     - use npm ci for reproducible installs
#     - Moved COPY . . after npm install — dependency install should come before copying source code so the layer is cached and only rebuilt when package files change, not on every source change
#     - Converted CMD/ENTRYPOINT to exec (JSON array) form — shell form runs as /bin/sh -c which does not forward OS signals (SIGTERM) to the process, causing 10-second graceful shutdown delays
#     - exec form PID 1 receives signals directly
#     - Added tini as PID 1 — without an init process, SIGTERM is not properly forwarded to app processes, causing 10-second graceful shutdown timeouts
#     - tini also reaps zombie processes
#     - Added STOPSIGNAL SIGINT — Node.js applications often handle SIGINT (Ctrl+C) but not SIGTERM
#     - setting the correct stop signal ensures docker stop triggers graceful shutdown instead of SIGKILL after a 10s timeout
#     - Added HEALTHCHECK with 15s start-period — Docker marks container as unhealthy immediately without a healthcheck, triggering premature load balancer removal
#     - start-period gives slow-starting services time to initialize
#
# Apply:      git apply 04-advanced/087-dockerfile_syntax.diff
diff --git a/.dockerignore b/.dockerignore
new file mode 100644
--- /dev/null
+++ b/.dockerignore
@@ -0,0 +1,37 @@
+.git
+.github
+.gitignore
+node_modules
+.npm
+npm-debug.log*
+.eslintcache
+dist
+build
+out
+coverage
+.env
+.env.*
+!.env.example
+*.md
+docs/
+test/
+tests/
+.DS_Store
+Thumbs.db
+docker-compose*.yml
+.dockerignore
+Dockerfile*
+# Secrets — must never reach the Docker build context
+*.pem
+*.key
+*.p12
+*.pfx
+.env.production
+.env.local
+secrets/
+credentials/
+*.secret
+id_rsa
+id_ed25519
+*.crt
+kubeconfig
diff --git a/Dockerfile b/Dockerfile
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,5 +1,14 @@
 FROM node:20-alpine
-WORKDIR app
-ADD . .
-RUN npm ci
-CMD node server.js
+WORKDIR /app
+RUN apk add --no-cache tini
+COPY . .  # Changed from ADD: use ADD only for URLs or tar auto-extraction
+COPY package*.json ./
+RUN npm ci --omit=dev --ignore-scripts
+COPY . .
+RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 --ingroup nodejs nodeuser
+USER nodeuser
+ENTRYPOINT ["/sbin/tini", "--"]
+STOPSIGNAL SIGINT  # Node.js handles SIGINT for graceful shutdown; adjust for your framework
+CMD ["node","server.js"]
+HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
+  CMD wget -qO- http://localhost:3000/health 2>/dev/null || curl -f http://localhost:3000/health 2>/dev/null || exit 1
