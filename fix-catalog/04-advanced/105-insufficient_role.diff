# Aegis fix catalog #105 — IAM role lacks a required action
#
# Tier:       4 · Advanced
# Category:   insufficient_role (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | An error occurred (AccessDenied) when calling the PutObject operation: User: arn:aws:sts::1:assumed-role/ci is not authorized to perform: s3:PutObject on resource: arn:aws:s3:::acme-app/*
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added AWS_DEFAULT_REGION=us-east-1 — AWS CLI and SDK require a region
#     - without it commands fail with 'You must specify a region'
#     - update to your target region
#     - AWS AccessDenied — role is missing "s3:PutObject" on "arn:aws:s3:::acme-app/*"
#     - add this action to the role's IAM policy in the AWS console or via Terraform/CloudFormation
#     - use IAM Access Analyzer to generate least-privilege policy
#
# Apply:      git apply 04-advanced/105-insufficient_role.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,6 +14,9 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  AWS_DEFAULT_REGION: us-east-1
+  # aegis: IAM policy missing "s3:PutObject" on "arn:aws:s3:::acme-app/*"
+  # Add to role policy: { "Effect": "Allow", "Action": "s3:PutObject", "Resource": "arn:aws:s3:::acme-app/*" }
 jobs:
   build:
     runs-on: ubuntu-latest
