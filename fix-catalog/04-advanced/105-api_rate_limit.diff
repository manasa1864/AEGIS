# Aegis fix catalog #105 — GitHub API secondary rate limit
#
# Tier:       4 · Advanced
# Category:   api_rate_limit (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | HttpError: API rate limit exceeded for installation ID 12345.
#   | status: 429 Too Many Requests
#   | x-ratelimit-remaining: 0
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added 2-second backoff before API calls — 429 rate limit detected
#     - increase sleep if still throttled
#
# Apply:      git apply 04-advanced/105-api_rate_limit.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -25,4 +25,6 @@
           node-version: 20
           cache: npm
       - run: npm ci
-      - run: gh api repos/acme/app/pulls --paginate
+      - run: |
+          sleep 2  # rate-limit backoff
+          run: gh api repos/acme/app/pulls --paginate
