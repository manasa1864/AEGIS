# Aegis fix catalog #125 — Post-deploy health check fails immediately
#
# Tier:       4 · Advanced
# Category:   health_check_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | health check failed: GET /health returned 503
#   | Readiness probe failed: HTTP probe failed with statuscode: 503
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added kubectl rollout status --timeout=120s after apply — verifies all pods become Running before marking deploy successful
#     - Added kubernetes.io/change-cause annotation after kubectl apply — annotating deployments enables meaningful `kubectl rollout history` entries for targeted rollback
#     - Added kubectl apply --dry-run=server before actual apply — server-side dry-run validates against the live API server schema, catching invalid field names and types before modifying cluster state
#   MODIFY k8s/deployment.yaml
#     - Added readinessProbe (delay 15s) + livenessProbe (delay 30s) on port 3000 — prevents traffic routing before app is ready and auto-restarts unresponsive containers
#     - Added revisionHistoryLimit: 5 to Deployment spec — default of 10 wastes etcd space
#     - 0 would prevent rollback
#     - 5 retains 5 revisions for `kubectl rollout undo`
#     - Added PodDisruptionBudget (minAvailable: 1) for app — ensures at least one pod remains running during node drains, upgrades, and voluntary disruptions
#     - Added topologySpreadConstraints (maxSkew: 1, zone) — distributes pods evenly across availability zones
#     - prevents all pods from landing in the same zone, which would cause an outage if that zone becomes unavailable
#     - Added AWS Load Balancer Controller readinessGate — pod is not included in the ALB target group until the target health condition is satisfied, preventing premature traffic routing
#
# Apply:      git apply 04-advanced/125-health_check_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -26,5 +26,8 @@
           cache: npm
       - run: npm ci
       - run: npm run build
-      - run: kubectl apply -f k8s/deployment.yaml
+      - run: kubectl apply --dry-run=server -f $2 && kubectl apply -f k8s/deployment.yaml
+          kubectl annotate deployment --all kubernetes.io/change-cause="Deploy ${GITHUB_SHA:-$(git rev-parse --short HEAD)} by ${GITHUB_ACTOR:-CI}" --overwrite
+          kubectl rollout status deployment --timeout=120s
+          kubectl get pods --field-selector=status.phase!=Running 2>/dev/null || true
       - run: curl -f https://app.example.com/health
diff --git a/k8s/deployment.yaml b/k8s/deployment.yaml
--- a/k8s/deployment.yaml
+++ b/k8s/deployment.yaml
@@ -3,6 +3,7 @@
 metadata:
   name: app
 spec:
+  revisionHistoryLimit: 5
   replicas: 2
   selector:
     matchLabels:
@@ -12,8 +13,42 @@
       labels:
         app: app
     spec:
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: topology.kubernetes.io/zone
+          whenUnsatisfiable: DoNotSchedule
+          labelSelector:
+            matchLabels:
+              app: app
+      readinessGates:
+        - conditionType: "target-health.elbv2.k8s.aws/app-tg"
       containers:
         - name: app
           image: ghcr.io/acme/app:latest
+          readinessProbe:
+            httpGet:
+              path: /health
+              port: 3000
+            initialDelaySeconds: 15
+            periodSeconds: 5
+            failureThreshold: 3
+          livenessProbe:
+            httpGet:
+              path: /health
+              port: 3000
+            initialDelaySeconds: 30
+            periodSeconds: 15
+            failureThreshold: 3
           ports:
             - containerPort: 3000
+
+---
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: app-pdb
+spec:
+  minAvailable: 1
+  selector:
+    matchLabels:
+      app: app
