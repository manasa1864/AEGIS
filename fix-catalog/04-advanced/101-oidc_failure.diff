# Aegis fix catalog #101 — OIDC token request without id-token permission
#
# Tier:       4 · Advanced
# Category:   oidc_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | Error: Could not get ID token for authentication — oidc token request failed
#   | Error: Unable to get ACTIONS_ID_TOKEN_REQUEST_URL env variable
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added AWS_DEFAULT_REGION=us-east-1 — AWS CLI and SDK require a region
#     - without it commands fail with 'You must specify a region'
#     - update to your target region
#     - Added id-token: write — OIDC cloud federation (AWS/GCP/Azure) requires this permission on the GITHUB_TOKEN
#
# Apply:      git apply 04-advanced/101-oidc_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -8,12 +8,14 @@
   pull_request:
 permissions:
   contents: read
+  id-token: write
 concurrency:
   group: ci-${{ github.ref }}
   cancel-in-progress: true
 env:
   CI: 'true'
   NODE_ENV: test
+  AWS_DEFAULT_REGION: us-east-1
 jobs:
   build:
     runs-on: ubuntu-latest
