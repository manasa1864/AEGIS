# Aegis fix catalog #124 — Deploy targets a service returning 503
#
# Tier:       4 · Advanced
# Category:   service_unavailable (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | curl: (22) The requested URL returned error: 503 Service Unavailable
#   | 502 Bad Gateway during deploy
#
# How it is solved:
#   MODIFY k8s/deployment.yaml
#     - Added terminationGracePeriodSeconds: 60 + preStop sleep 5s — gives in-flight requests 5 seconds to complete before SIGTERM propagates
#     - K8s routes no new requests during this window
#
# Apply:      git apply 04-advanced/124-service_unavailable.diff
diff --git a/k8s/deployment.yaml b/k8s/deployment.yaml
--- a/k8s/deployment.yaml
+++ b/k8s/deployment.yaml
@@ -22,9 +22,14 @@
               app: app
       readinessGates:
         - conditionType: "target-health.elbv2.k8s.aws/app-tg"
+      terminationGracePeriodSeconds: 60
       containers:
         - name: app
           image: ghcr.io/acme/app:latest
+          lifecycle:
+            preStop:
+              exec:
+                command: ["/bin/sh", "-c", "sleep 5"]
           readinessProbe:
             httpGet:
               path: /health
