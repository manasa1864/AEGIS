# Aegis fix catalog #132 — Parallel tests deadlock the database
#
# Tier:       4 · Advanced
# Category:   db_deadlock (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | error: deadlock detected
#   | DETAIL: Process 1432 waits for ShareLock on transaction 5521; blocked by process 1433.
#   | ER_LOCK_DEADLOCK
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added deadlock retry configuration — deadlocks are transient
#     - exponential backoff retry resolves most cases without manual intervention
#     - Set lock_timeout=5s and deadlock_timeout=1s — long lock waits cascade into deadlock storms
#     - short timeouts force fast failure and retry
#     - Set READ COMMITTED isolation level — SERIALIZABLE causes more deadlocks
#     - READ COMMITTED prevents phantom reads while dramatically reducing contention
#
# Apply:      git apply 04-advanced/132-db_deadlock.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,6 +14,14 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  # aegis: deadlock — enable ORM-level retry
+  DEADLOCK_RETRY_ATTEMPTS: "5"
+  DEADLOCK_RETRY_DELAY_MS: "200"
+  TYPEORM_RETRY_DELAY: "200"
+  SEQUELIZE_RETRY_ATTEMPTS: "5"
+  PGOPTIONS: "-c lock_timeout=5000 -c deadlock_timeout=1000"
+  DB_ISOLATION_LEVEL: READ COMMITTED
+  TYPEORM_ISOLATION_LEVEL: READ COMMITTED
 jobs:
   build:
     runs-on: ubuntu-latest
