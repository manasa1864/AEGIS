# Aegis fix catalog #093 — GHCR push without login / packages permission
#
# Tier:       4 · Advanced
# Category:   registry_auth_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | denied: installation not allowed to Write organization package
#   | ERROR: push access denied to registry ghcr.io — unauthorized registry push
#
# How it is solved:
#   CREATE .dockerignore
#     - Created .dockerignore — without it, docker build sends node_modules, .git, and test files to the build context
#     - this increases build time, image size, and can leak secrets from .env files into the image
#     - Added secret file patterns to .dockerignore (*.pem, *.key, *.p12, *.pfx, ...) — if these files exist in the build context, COPY . . would include them in the image layer, permanently exposing secrets in docker history
#   MODIFY .github/workflows/ci.yml
#     - Added DOCKER_BUILDKIT=1 — enables BuildKit for faster layer caching and parallel build stages
#     - Added packages: write — pushing to ghcr.io requires this permission on the GITHUB_TOKEN
#     - also ensure the package visibility allows the workflow
#
# Apply:      git apply 04-advanced/093-registry_auth_failure.diff
diff --git a/.dockerignore b/.dockerignore
new file mode 100644
--- /dev/null
+++ b/.dockerignore
@@ -0,0 +1,37 @@
+.git
+.github
+.gitignore
+node_modules
+.npm
+npm-debug.log*
+.eslintcache
+dist
+build
+out
+coverage
+.env
+.env.*
+!.env.example
+*.md
+docs/
+test/
+tests/
+.DS_Store
+Thumbs.db
+docker-compose*.yml
+.dockerignore
+Dockerfile*
+# Secrets — must never reach the Docker build context
+*.pem
+*.key
+*.p12
+*.pfx
+.env.production
+.env.local
+secrets/
+credentials/
+*.secret
+id_rsa
+id_ed25519
+*.crt
+kubeconfig
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -8,12 +8,15 @@
   pull_request:
 permissions:
   contents: read
+  packages: write
 concurrency:
   group: ci-${{ github.ref }}
   cancel-in-progress: true
 env:
   CI: 'true'
   NODE_ENV: test
+  DOCKER_BUILDKIT: 1
+  BUILDKIT_INLINE_CACHE: 1
 jobs:
   build:
     runs-on: ubuntu-latest
