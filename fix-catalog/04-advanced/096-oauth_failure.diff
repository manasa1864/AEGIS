# Aegis fix catalog #096 — OAuth token missing a required scope
#
# Tier:       4 · Advanced
# Category:   oauth_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | OAuthError: insufficient_scope — required scope not granted: read:org
#   | HttpError: oauth token invalid for this operation
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Missing OAuth scope 'not granted: read:org' — add the required scope to your authorization URL (?scope=<value>) and update the OAuth app to request these scopes
#     - users may need to re-authorize
#
# Apply:      git apply 04-advanced/096-oauth_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -14,6 +14,7 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  OAUTH_SCOPES: 'not granted: read:org'  # Add required OAuth scopes to your auth request
 jobs:
   build:
     runs-on: ubuntu-latest
