# Aegis fix catalog #104 — Environment secret used outside its environment
#
# Tier:       4 · Advanced
# Category:   secret_access_denied
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | Error: Input required and not supplied: deploy-key
#   | environment secret not accessible — this secret is only available to jobs that reference the 'production' environment
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added environment: secret to job — environment-scoped secrets are only accessible when the job declares the matching environment name
#     - also add environment protection rules at Settings > Environments
#
# Apply:      git apply 04-advanced/104-secret_access_denied.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -16,6 +16,7 @@
   NODE_ENV: test
 jobs:
   build:
+    environment: secret
     runs-on: ubuntu-latest
     timeout-minutes: 15
     steps:
