# Aegis fix catalog #125 — Third-party scanner outage blocks the build
#
# Tier:       4 · Advanced
# Category:   third_party_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | Snyk API request failed: third-party service returned 503
#   | external service unavailable — SonarCloud quality gate timed out
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added timeout-minutes: 30 to all jobs — GitHub's default is 360 minutes (6 hours)
#     - a hung process (infinite loop, waiting for input, deadlocked DB) will burn runner quota and block other jobs for hours without an explicit timeout
#     - Added MAX_ITERATIONS/MAX_RETRIES env vars — CI hung
#     - build scripts can read these caps to bail out of runaway loops
#
# Apply:      git apply 04-advanced/125-third_party_failure.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -1,11 +1,13 @@
 name: CI
 on:
   push:
+    timeout-minutes: 30
     branches: [main]
     paths-ignore:
       - '**.md'
       - 'docs/**'
   pull_request:
+    timeout-minutes: 30
 permissions:
   contents: read
 concurrency:
@@ -14,6 +16,8 @@
 env:
   CI: 'true'
   NODE_ENV: test
+  MAX_ITERATIONS: 1000
+  MAX_RETRIES: 5
 jobs:
   build:
     runs-on: ubuntu-latest
