# Aegis fix catalog #130 — Blue/green traffic switch conflict
#
# Tier:       4 · Advanced
# Category:   blue_green_conflict (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | Error: blue green conflict — both slots report active
#   | traffic switch failed: service selector already points to green
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added K8s Service selector patch to toggle blue/green traffic — atomically moves all traffic to the new slot by changing the `slot` label selector without downtime
#
# Apply:      git apply 04-advanced/130-blue_green_conflict.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -25,6 +25,15 @@
           node-version: 20
       - run: npm install
       - run: npm run build
+      - name: Blue-green Service selector switch
+        run: |
+          ACTIVE="${ACTIVE_SLOT:-blue}"
+          NEW=$( [ "$ACTIVE" = "blue" ] && echo "green" || echo "blue" )
+          echo "Switching Service selector from $ACTIVE → $NEW"
+          kubectl patch service "${{ env.SERVICE_NAME }}" \
+            -p "{\"spec\":{\"selector\":{\"slot\":\"$NEW\"}}}"
+          echo "Traffic now routed to $NEW slot"
+          echo "NEW_ACTIVE=$NEW" >> "$GITHUB_ENV"
       - run: kubectl apply --dry-run=server -f $2 && kubectl apply -f k8s/deployment.yaml
           kubectl annotate deployment --all kubernetes.io/change-cause="Deploy ${GITHUB_SHA:-$(git rev-parse --short HEAD)} by ${GITHUB_ACTOR:-CI}" --overwrite
           kubectl rollout status deployment --timeout=120s
