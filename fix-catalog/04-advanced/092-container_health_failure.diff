# Aegis fix catalog #092 — Container has no HEALTHCHECK
#
# Tier:       4 · Advanced
# Category:   container_health_failure (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | container app is unhealthy
#   | health check failed after 3 retries
#   | Error: container unhealthy — dependency failed to start
#
# How it is solved:
#   CREATE .dockerignore
#     - Created .dockerignore — without it, docker build sends node_modules, .git, and test files to the build context
#     - this increases build time, image size, and can leak secrets from .env files into the image
#     - Added secret file patterns to .dockerignore (*.pem, *.key, *.p12, *.pfx, ...) — if these files exist in the build context, COPY . . would include them in the image layer, permanently exposing secrets in docker history
#   MODIFY docker-compose.yml
#     - Removed version: field from Docker Compose — the version: top-level field is obsolete in Compose v2 (docker compose CLI)
#     - its presence generates a deprecation warning and in some versions causes validation errors
#     - Added logging limits (10MB x 3 files) to docker-compose — without log rotation, container logs grow unboundedly and can fill the host disk, causing all containers on the host to fail
#     - Added init: true to docker-compose service — equivalent to docker run --init
#     - runs tini as PID 1, ensuring SIGTERM is forwarded to the app and zombie processes are reaped
#     - prevents 10-second shutdown delays
#   MODIFY Dockerfile
#     - Added HEALTHCHECK instruction to Dockerfile — container was reported unhealthy without one
#     - Added tini as PID 1 — without an init process, SIGTERM is not properly forwarded to app processes, causing 10-second graceful shutdown timeouts
#     - tini also reaps zombie processes
#     - Moved COPY . . after npm install — dependency install should come before copying source code so the layer is cached and only rebuilt when package files change, not on every source change
#     - Added non-root USER before CMD — containers running as root violate the principle of least privilege and fail many security scanners (Trivy, Snyk, AWS ECR scan)
#     - UID 1001 is a common non-privileged choice
#     - Added STOPSIGNAL SIGINT — Node.js applications often handle SIGINT (Ctrl+C) but not SIGTERM
#     - setting the correct stop signal ensures docker stop triggers graceful shutdown instead of SIGKILL after a 10s timeout
#
# Apply:      git apply 04-advanced/092-container_health_failure.diff
diff --git a/.dockerignore b/.dockerignore
new file mode 100644
--- /dev/null
+++ b/.dockerignore
@@ -0,0 +1,37 @@
+.git
+.github
+.gitignore
+node_modules
+.npm
+npm-debug.log*
+.eslintcache
+dist
+build
+out
+coverage
+.env
+.env.*
+!.env.example
+*.md
+docs/
+test/
+tests/
+.DS_Store
+Thumbs.db
+docker-compose*.yml
+.dockerignore
+Dockerfile*
+# Secrets — must never reach the Docker build context
+*.pem
+*.key
+*.p12
+*.pfx
+.env.production
+.env.local
+secrets/
+credentials/
+*.secret
+id_rsa
+id_ed25519
+*.crt
+kubeconfig
diff --git a/docker-compose.yml b/docker-compose.yml
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -1,4 +1,3 @@
-version: "3.8"
 services:
   app:
     build: .
@@ -8,5 +7,11 @@
       - db
   db:
     image: postgres:16
+    init: true  # Run tini as PID 1 for proper signal forwarding and zombie reaping
+    logging:
+      driver: json-file
+      options:
+        max-size: "10m"
+        max-file: "3"
     environment:
       POSTGRES_PASSWORD: postgres
diff --git a/Dockerfile b/Dockerfile
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,6 +1,16 @@
 FROM node:20-alpine
 WORKDIR /app
-COPY . .
+RUN apk add --no-cache tini
+COPY package*.json ./
 RUN npm ci --omit=dev
+COPY . .
 EXPOSE 3000
+RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 --ingroup nodejs nodeuser
+USER nodeuser
+ENTRYPOINT ["/sbin/tini", "--"]
+STOPSIGNAL SIGINT  # Node.js handles SIGINT for graceful shutdown; adjust for your framework
 CMD ["node", "server.js"]
+
+HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
+  CMD wget -qO- http://localhost:3000/health || exit 1
+
