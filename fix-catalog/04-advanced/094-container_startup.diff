# Aegis fix catalog #094 — Container starts before its dependencies
#
# Tier:       4 · Advanced
# Category:   container_startup (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | app-1  | Error: connect ECONNREFUSED 172.18.0.2:5432
#   | app-1 exited with code 1
#   | container did not start — container health unhealthy
#
# How it is solved:
#   CREATE .dockerignore
#     - Created .dockerignore — without it, docker build sends node_modules, .git, and test files to the build context
#     - this increases build time, image size, and can leak secrets from .env files into the image
#     - Added secret file patterns to .dockerignore (*.pem, *.key, *.p12, *.pfx, ...) — if these files exist in the build context, COPY . . would include them in the image layer, permanently exposing secrets in docker history
#   MODIFY .github/workflows/ci.yml
#     - Added docker-compose up/down around integration tests — ECONNREFUSED
#     - services start before tests and always tear down after
#   MODIFY docker-compose.yml
#     - Removed version: field from Docker Compose — the version: top-level field is obsolete in Compose v2 (docker compose CLI)
#     - its presence generates a deprecation warning and in some versions causes validation errors
#     - Added logging limits (10MB x 3 files) to docker-compose — without log rotation, container logs grow unboundedly and can fill the host disk, causing all containers on the host to fail
#     - Added init: true to docker-compose service — equivalent to docker run --init
#     - runs tini as PID 1, ensuring SIGTERM is forwarded to the app and zombie processes are reaped
#     - prevents 10-second shutdown delays
#
# Apply:      git apply 04-advanced/094-container_startup.diff
diff --git a/.dockerignore b/.dockerignore
new file mode 100644
--- /dev/null
+++ b/.dockerignore
@@ -0,0 +1,37 @@
+.git
+.github
+.gitignore
+node_modules
+.npm
+npm-debug.log*
+.eslintcache
+dist
+build
+out
+coverage
+.env
+.env.*
+!.env.example
+*.md
+docs/
+test/
+tests/
+.DS_Store
+Thumbs.db
+docker-compose*.yml
+.dockerignore
+Dockerfile*
+# Secrets — must never reach the Docker build context
+*.pem
+*.key
+*.p12
+*.pfx
+.env.production
+.env.local
+secrets/
+credentials/
+*.secret
+id_rsa
+id_ed25519
+*.crt
+kubeconfig
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -26,4 +26,13 @@
           cache: npm
       - run: npm ci
       - run: npm run build
+      - name: Start integration test services
+        run: |
+          docker-compose -f docker-compose.yml up -d
+          sleep 15
+          docker-compose ps
       - run: npm test
+
+      - name: Stop integration test services
+        if: always()
+        run: docker-compose -f docker-compose.yml down --volumes
\ No newline at end of file
diff --git a/docker-compose.yml b/docker-compose.yml
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -1,4 +1,3 @@
-version: "3.8"
 services:
   app:
     build: .
@@ -8,5 +7,11 @@
       - db
   db:
     image: postgres:16
+    init: true  # Run tini as PID 1 for proper signal forwarding and zombie reaping
+    logging:
+      driver: json-file
+      options:
+        max-size: "10m"
+        max-file: "3"
     environment:
       POSTGRES_PASSWORD: postgres
