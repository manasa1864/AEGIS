# Aegis fix catalog #088 — Docker builds never reuse cached layers
#
# Tier:       4 · Advanced
# Category:   missing_docker_layer (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | #5 importing cache manifest from ghcr.io/acme/app:buildcache
#   | #5 ERROR: layer not found in cache — cache miss on every layer
#
# How it is solved:
#   CREATE .dockerignore
#     - Created .dockerignore — without it, docker build sends node_modules, .git, and test files to the build context
#     - this increases build time, image size, and can leak secrets from .env files into the image
#     - Added secret file patterns to .dockerignore (*.pem, *.key, *.p12, *.pfx, ...) — if these files exist in the build context, COPY . . would include them in the image layer, permanently exposing secrets in docker history
#   MODIFY .github/workflows/ci.yml
#     - Added cache-from/cache-to GitHub Actions cache to docker/build-push-action — missing layers are re-pulled every build without layer caching
#     - Added docker/setup-buildx-action — docker/build-push-action requires the Buildx builder
#     - without it cache-from, multi-platform, and advanced build options are unavailable
#     - Added docker/metadata-action for tag generation — hardcoded tags break multi-arch manifests
#     - metadata-action generates correct tags for branches, PRs, semver, and SHA
#     - reference with ${{ steps.meta.outputs.tags }}
#     - Added Trivy vulnerability scan after build — scan results appear in GitHub Security tab
#     - exit-code: 0 means findings are reported but do not fail CI
#     - change to 1 to block on CRITICAL/HIGH vulnerabilities
#
# Apply:      git apply 04-advanced/088-missing_docker_layer.diff
diff --git a/.dockerignore b/.dockerignore
new file mode 100644
--- /dev/null
+++ b/.dockerignore
@@ -0,0 +1,37 @@
+.git
+.github
+.gitignore
+node_modules
+.npm
+npm-debug.log*
+.eslintcache
+dist
+build
+out
+coverage
+.env
+.env.*
+!.env.example
+*.md
+docs/
+test/
+tests/
+.DS_Store
+Thumbs.db
+docker-compose*.yml
+.dockerignore
+Dockerfile*
+# Secrets — must never reach the Docker build context
+*.pem
+*.key
+*.p12
+*.pfx
+.env.production
+.env.local
+secrets/
+credentials/
+*.secret
+id_rsa
+id_ed25519
+*.crt
+kubeconfig
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -25,7 +25,35 @@
           node-version: 20
           cache: npm
       - run: npm ci
+      - name: Set up Docker Buildx
+        uses: docker/setup-buildx-action@v3
+      - name: Extract Docker metadata
+        id: meta
+        uses: docker/metadata-action@v5
+        with:
+          images: ${{ env.IMAGE_NAME }}
+          tags: |
+            type=ref,event=branch
+            type=ref,event=pr
+            type=semver,pattern={{version}}
+            type=sha,prefix=sha-
       - uses: docker/build-push-action@v5
         with:
           push: false
+          cache-from: type=gha
+          cache-to: type=gha,mode=max
           tags: app:ci
+
+      - name: Scan image for vulnerabilities
+        uses: aquasecurity/trivy-action@0.20.0
+        with:
+          image-ref: ${{ env.IMAGE_NAME }}:${{ github.sha }}
+          format: sarif
+          output: trivy-results.sarif
+          severity: CRITICAL,HIGH
+          exit-code: 0  # Set to 1 to fail on vulnerabilities
+      - name: Upload Trivy results to Security tab
+        if: always()
+        uses: github/codeql-action/upload-sarif@v3
+        with:
+          sarif_file: trivy-results.sarif
