# Aegis fix catalog #103 — Checking out another private repository
#
# Tier:       4 · Advanced
# Category:   cross_project_access (auto-diagnosed from the log below)
# Engine:     deterministic rule engine — no AI involved
#
# CI log:
#   | remote: Repository not found.
#   | fatal: repository 'https://github.com/acme/shared-config/' not found
#   | cross project access denied
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added GH_PAT token for cross-repo checkout — GITHUB_TOKEN only has access to the workflow repository
#     - cross-repo checkout requires a PAT with repo scope or a GitHub App token installed on both repos
#
# Apply:      git apply 04-advanced/103-cross_project_access.diff
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -27,5 +27,6 @@
       - run: npm ci
       - uses: actions/checkout@v4
         with:
+          token: ${{ secrets.GH_PAT }}  # PAT with repo scope required for cross-repo checkout
           repository: acme/shared-config
           path: shared
