   CI: 'true'
   NODE_ENV: test
+  NODE_OPTIONS: --unhandled-rejections=throw
 jobs:
   build:
     runs-on: ubuntu-latest
diff --git a/src/pricing.ts b/src/pricing.ts
--- a/src/pricing.ts
+++ b/src/pricing.ts
@@ -1,6 +1,6 @@
 export function calculateTotal(items: { qty: number; unitPrice: number }[]): number {
   let subtotal = 0;
-  for (let i = 0; i <= items.length; i++) {
+  for (let i = 0; i < items.length; i++) {
     subtotal += items[i].qty * items[i].unitPrice;
   }
   return subtotal;
