#   |     at calculateTotal (/home/runner/work/app/app/src/pricing.ts:4:28)
#   |     at Object.<anonymous> (/home/runner/work/app/app/test/pricing.test.ts:5:12)
#
# How it is solved:
#   MODIFY .github/workflows/ci.yml
#     - Added --unhandled-rejections=throw — TypeError silently passed CI
#   MODIFY src/pricing.ts
