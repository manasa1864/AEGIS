# ── Aegis Flask Backend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it contains secrets.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Format: postgresql://username:password@host:port/database_name
#
# Local setup (after installing PostgreSQL):
#   DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/aegis
#
# Render setup:
#   When you add a PostgreSQL database on Render, it gives you a
#   DATABASE_URL automatically — copy it here or set it in Render's env vars.
DATABASE_URL=postgresql://postgres:password@localhost:5432/aegis

# ── Flask ──────────────────────────────────────────────────────────────────────
# Random secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex())"
SECRET_KEY=change-me-to-something-random-and-long
